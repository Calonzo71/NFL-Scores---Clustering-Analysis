    "# ============================================================\n",
    "# K-MEANS CLUSTERING: Group teams by performance\n",
    "# ============================================================\n",
    "\n",
    "# Prepare features for clustering (offensive and defensive metrics)\n",
    "X = team_stats[['points_scored', 'points_allowed']]\n",
    "\n",
    "# Scale features to have mean=0 and variance=1\n",
    "# This ensures both features contribute equally to the clustering\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "# Perform K-means clustering with 4 clusters\n",
    "# random_state=42 ensures reproducible results\n",
    "kmeans = KMeans(n_clusters=4, random_state=42)\n",
    "team_stats['cluster'] = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "# Get cluster centroids and transform back to original scale for interpretation\n",
    "centroids = pd.DataFrame(\n",
    "    scaler.inverse_transform(kmeans.cluster_centers_),\n",
    "    columns=['points_scored', 'points_allowed']\n",
    ")\n",
    "\n",
    "# Display clustering results\n",
    "print(\"Cluster Centroids:\")\n",
    "print(centroids)\n",
    "print(\"\\nTeams by Cluster:\")\n",
    "for cluster_id in sorted(team_stats['cluster'].unique()):\n",
    "    teams = team_stats[team_stats['cluster'] == cluster_id]['team'].tolist()\n",
    "    print(f\"\\nCluster {cluster_id}: {len(teams)} teams\")\n",
    "    print(\", \".join(teams))"
   ]
  },
