    "# ============================================================\n",
    "# VISUALIZATION: Create scatter plot with cluster assignments\n",
    "# ============================================================\n",
    "\n",
    "# Set up the plot\n",
    "plt.figure(figsize=(14, 10))\n",
    "colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A']  # Color scheme for each cluster\n",
    "\n",
    "# Define descriptive names for each cluster based on their characteristics\n",
    "# Cluster 0: Good offense, good defense\n",
    "# Cluster 1: Weak offense, weak defense  \n",
    "# Cluster 2: Strong offense, variable defense (elite teams)\n",
    "# Cluster 3: Average performance across the board\n",
    "cluster_names = {\n",
    "    0: 'Struggling Offenses',\n",
    "    1: 'The Rebuilding',\n",
    "    2: 'The Contenders',\n",
    "    3: 'The Middle of the Pack'\n",
    "}\n",
    "\n",
    "# Plot each cluster with its own color\n",
    "for label in team_stats['cluster'].unique():\n",
    "    subset = team_stats[team_stats['cluster'] == label]\n",
    "    plt.scatter(\n",
    "        subset['points_scored'], \n",
    "        subset['points_allowed'], \n",
    "        label=cluster_names[label],  # Use descriptive name in legend\n",
    "        s=150,  # Marker size\n",
    "        alpha=0.6,  # Transparency\n",
    "        color=colors[label],\n",
    "        edgecolors='black',\n",
    "        linewidth=1.5\n",
    "    )\n",
    "    \n",
    "    # Add team name labels to each point for identification\n",
    "    for idx, row in subset.iterrows():\n",
    "        plt.annotate(\n",
    "            row['team'], \n",
    "            (row['points_scored'], row['points_allowed']),\n",
    "            fontsize=8,\n",
    "            ha='center',\n",
    "            va='bottom',\n",
    "            alpha=0.8\n",
    "        )\n",
    "\n",
    "# Plot cluster centroids (center point of each cluster)\n",
    "plt.scatter(\n",
    "    centroids['points_scored'],\n",
    "    centroids['points_allowed'],\n",
    "    marker='X',  # X marker for centroids\n",
    "    s=500,  # Larger size to stand out\n",
    "    c='black',\n",
    "    edgecolors='white',\n",
    "    linewidth=2,\n",
    "    label='Centroids',\n",
    "    zorder=5  # Plot on top of other points\n",
    ")\n",
    "\n",
    "# Customize plot appearance\n",
    "plt.xlabel('Average Points Scored', fontsize=12, fontweight='bold')\n",
    "plt.ylabel('Average Points Allowed', fontsize=12, fontweight='bold')\n",
    "plt.title('NFL Team Clusters: Offensive vs Defensive Performance (2025 Regular Season)', \n",
    "          fontsize=14, fontweight='bold', pad=20)\n",
    "plt.legend(loc='best', fontsize=10)\n",
