   "source": [
    "# NFL Team Clustering Analysis - 2025 Season\n",
    "# This notebook performs K-means clustering on NFL teams based on their offensive and defensive performance\n",
    "# Data is collected from ESPN's API for weeks 1-18 of the 2025 season\n",
    "\n",
    "# Import required libraries\n",
    "import requests  # For making API calls to ESPN\n",
    "import pandas as pd  # For data manipulation and analysis\n",
    "import matplotlib.pyplot as plt  # For creating visualizations\n",
    "from sklearn.cluster import KMeans  # For K-means clustering algorithm\n",
    "from sklearn.preprocessing import StandardScaler  # For feature scaling\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "14430e01",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_weekly_scores(year=2025, weeks=None):\n",
    "    \"\"\"\n",
    "    Fetch NFL game scores from ESPN API for specified weeks.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    year : int\n",
    "        The NFL season year (default: 2025)\n",
    "    weeks : int, list, or None\n",
    "        Week number(s) to fetch. Can be a single week, list of weeks, or None for week 1\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    pd.DataFrame\n",
    "        DataFrame containing game data with columns:\n",
    "        - game_id: Unique identifier for each game\n",
    "        - date: Game date\n",
    "        - week: Week number\n",
    "        - team: Team name\n",
    "        - homeAway: Whether team was home or away\n",
    "        - Points_Scored: Points scored by the team\n",
    "        - Points_Allowed: Points allowed by the team\n",
    "        - opponent: Opponent team name\n",
    "    \"\"\"\n",
    "    url = \"http://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard\"\n",
    "    all_rows = []\n",
    "\n",
    "    # Convert weeks parameter to list format for consistent processing\n",
    "    if isinstance(weeks, int):\n",
    "        weeks = [weeks]\n",
    "    elif weeks is None:\n",
    "        weeks = [1]  # default week\n",
    "\n",
    "    # Loop through each week and fetch game data\n",
    "    for week in weeks:\n",
    "        params = {\"year\": year, \"week\": week}\n",
    "        r = requests.get(url, params=params)\n",
    "        data = r.json()\n",
    "\n",
    "        # Extract game information from each event\n",
    "        for e in data.get('events', []):\n",
    "            comp = e['competitions'][0]\n",
    "            competitors = comp['competitors']\n",
    "\n",
    "            # Create a row for each team in the game\n",
    "            for c in competitors:\n",
    "                # Find the opponent (the other team in the game)\n",
    "                opp = next(x for x in competitors if x != c)\n",
    "                all_rows.append({\n",
    "                    'game_id': e['id'],\n",
    "                    'date': e['date'],\n",
    "                    'week': week,\n",
    "                    'team': c['team']['displayName'],\n",
    "                    'homeAway': c.get('homeAway'),\n",
    "                    'Points_Scored': int(c.get('score', 0)),\n",
    "                    'Points_Allowed': int(opp.get('score', 0)),\n",
    "                    'opponent': opp['team']['displayName']\n",
    "                })\n",
    "    return pd.DataFrame(all_rows)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b551a946",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# DATA COLLECTION: Fetch game data for all 18 weeks\n",
    "# ============================================================\n",
    "\n",
    "weeks_to_fetch = list(range(1, 19))  # Weeks 1 through 18 of the regular season\n",
    "\n",
    "# Collect all weekly DataFrames in a list\n",
    "all_dfs = []\n",
    "for w in weeks_to_fetch:\n",
    "    df_week = get_weekly_scores(weeks=w)\n",
    "    df_week['week'] = w\n",
    "    all_dfs.append(df_week)\n",
    "\n",
    "# Concatenate into one DataFrame containing all games from all weeks\n",
    "df_all = pd.concat(all_dfs, ignore_index=True)\n",
    "\n",
    "# Save to CSV for future use (can be loaded instead of re-fetching from API)\n",
    "df_all.to_csv(\"DataColumn.csv\",index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "7ac81ccf",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# DATA LOADING: Load the previously saved CSV\n",
    "# ============================================================\n",
    "# NOTE: Update this path to match your local file location\n",
    "\n",
    "df_all = pd.read_csv("Your File location here/DataColumn.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "45b65f3c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# DATA PREPROCESSING: Calculate team performance metrics\n",
    "# ============================================================\n",
    "# Calculate average points scored (offensive performance) and \n",
    "# average points allowed (defensive performance) for each team\n",
    "\n",
    "team_stats = (\n",
    "    df_all.groupby('team')\n",
    "    .agg(\n",
    "        points_scored=('Points_Scored', 'mean'),  # Offensive metric\n",
    "        points_allowed=('Points_Allowed', 'mean')  # Defensive metric\n",
    "    )\n",
    "    .reset_index()\n",
    ")"
   ]
  },
